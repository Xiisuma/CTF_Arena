
# ============================================================
# CTF Arena — .gitignore
# CHEMIN : /chemin/vers/ton/projet/.gitignore
# ============================================================

# ─── SECRETS — ne jamais commiter ────────────────────────────
# Toute variante de .env est ignorée (.env.bak, .env.old, .env.prod…),
# sauf le modèle sans secret.
.env
.env.*
!.env.example

# ─── Dépendances Node ─────────────────────────────────────────
node_modules/

# ─── Build Vite ──────────────────────────────────────────────
dist/
dist-ssr/

# ─── Uploads utilisateurs ────────────────────────────────────
uploads/*
!uploads/.gitkeep

# ─── Données Docker ──────────────────────────────────────────
# (les volumes MySQL sont locaux à la machine)

# ─── Sauvegardes base de données ─────────────────────────────
backups/

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── Éditeurs ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo

# ─── Cache ───────────────────────────────────────────────────
.cache/
.vite/

