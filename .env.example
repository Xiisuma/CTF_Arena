# ============================================================
# CTF Arena — modèle de configuration
#
# Copier ce fichier en .env puis remplacer chaque valeur.
#   cp .env.example .env
#
# Le .env réel n'est jamais commité (voir .gitignore).
# ============================================================

# ─── Base de données ─────────────────────────────────────────
# Mot de passe root MySQL. Obligatoire en production : sans lui,
# docker-compose retombe sur "root" comme valeur par défaut.
# Générer : openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# ─── Chiffrement des flags (AES-256-GCM) ─────────────────────
# 64 caractères hexadécimaux = 32 octets.
# Générer : openssl rand -hex 32
#
# ATTENTION : ne jamais changer cette clé après le premier lancement.
# Les flags déjà enregistrés en base deviendraient indéchiffrables.
FLAG_ENCRYPT_KEY=

# ─── Tokens de reset de mot de passe (HMAC-SHA256) ───────────
# Générer : openssl rand -hex 32
RESET_SECRET=

# ─── Compte administrateur ───────────────────────────────────
# Mot de passe du compte ALPHATEN créé au premier démarrage.
# Le backend refuse de démarrer si cette variable est vide.
# Générer : openssl rand -base64 24
ADMIN_PASSWORD=

# ─── Secret partagé backend ↔ ws-server ──────────────────────
# Protège le endpoint /notify du serveur WebSocket.
# Doit être identique pour les deux services.
# Générer : openssl rand -hex 32
NOTIFY_SECRET=

# ─── URLs ────────────────────────────────────────────────────
# URL publique du frontend, utilisée dans les liens des emails.
FRONTEND_URL=http://localhost:3000

# Origines autorisées par le CORS, séparées par des virgules.
# En production : uniquement l'origine publique réelle, en https.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Port d'exposition du frontend sur la machine hôte.
PORT=3000

# URL de l'API vue depuis le navigateur (injectée au build Vite).
# Laisser /api.php : nginx proxifie vers le backend.
VITE_API_URL=/api.php

# ─── Limitation de débit (optionnel) ─────────────────────────
# Valeurs par défaut si non définies. Utile à relâcher pendant un
# événement : 5 tentatives de flag par minute frustrent les joueurs
# qui se trompent de format.
# RATE_LIMIT_MAX=5              # connexions ratées, par IP
# RATE_LIMIT_WINDOW=300         # fenêtre, en secondes
# FLAG_ATTEMPT_MAX=5            # soumissions de flag erronées, par joueur
# FLAG_ATTEMPT_WINDOW=60        # fenêtre, en secondes
# REGISTER_MAX=30               # inscriptions, par IP
# REGISTER_WINDOW=3600          # fenêtre, en secondes
#
# Sur un événement sur site, tous les joueurs sortent par la même IP publique :
# REGISTER_MAX borne le nombre total d'inscriptions par heure pour le lieu.

# ─── SMTP (optionnel — emails de reset de mot de passe) ──────
# Sans ces variables, la fonctionnalité « mot de passe oublié »
# ne peut pas envoyer d'email.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@ctf-arena.local
